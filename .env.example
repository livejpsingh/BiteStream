# ==============================================================================
# BiteStream - Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in the values for local/staging/prod environments.
# DO NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Distributed Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_SSL_ENABLED=false

# Apache Kafka Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
