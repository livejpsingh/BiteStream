      "title": "Backend Log Volume by Level (Rate / 1m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 1 },
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=\"bitestream-app\"}[1m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Errors (Last 1 Hour)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"bitestream-app\"} |= \"ERROR\" [1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
